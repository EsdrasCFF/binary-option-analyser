# Connection string do Neon (Postgres serverless).
# Obtenha em https://console.neon.tech -> seu projeto -> Connection Details.
DATABASE_URL="postgres://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Segredos de autenticação (definir com valores fortes em produção)
JWT_SECRET="changeme"

# ⚠️ SOMENTE DESENVOLVIMENTO — placeholder enquanto a autenticação não existe.
# UUID de um registro da tabela `users` usado como "usuário logado" pelas rotas
# que gravam dados. Pode ser sobrescrito por requisição com o cabeçalho
# `x-user-id`. Em produção (NODE_ENV=production) essas rotas respondem 501 até
# a autenticação real ser implementada.
DEV_USER_ID=""
