# Connection string do Neon (Postgres serverless).
# Obtenha em https://console.neon.tech -> seu projeto -> Connection Details.
DATABASE_URL="postgres://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js v5 (next-auth@beta) — autenticação via Google.
# 1) Criar um OAuth Client em https://console.cloud.google.com/apis/credentials
#    (tipo "Web application").
# 2) Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (em produção, trocar pelo domínio real).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
